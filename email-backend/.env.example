# Copy these into Vercel → Settings → Environment Variables.
# NEVER commit real values. This file holds placeholders only.

# The Gmail account the code is sent FROM.
GMAIL_USER=soaked@gmail.com

# A Gmail APP PASSWORD (16 characters, spaces removed) — NOT the account
# password. Requires 2-Step Verification on that Google account.
# Create at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Name shown as the sender.
MAIL_FROM_NAME=Soaked

# Upstash Redis (free tier). Codes must outlive a single function instance.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Only this origin may call the API.
ALLOWED_ORIGIN=https://thueytunes.github.io
